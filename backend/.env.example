# AI Görsel Tahmin Oyunu - Ortam Değişkenleri Örneği
# Bu dosyayı .env olarak kopyalayın ve değerleri ayarlayın

# Veritabanı URL'i (varsayılan: SQLite)
DATABASE_URL=sqlite:///./app.db

# CORS izin verilen originler (virgülle ayrılmış)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# OpenAI API Anahtarı (DYNAMIC_AI=true için gerekli)
# https://platform.openai.com/api-keys adresinden alabilirsiniz
OPENAI_API_KEY=your_openai_api_key_here

# AI Görsel Modu
# true: Her oyunda OpenAI DALL-E ile yeni görsel üretir (API key gerekli, maliyet oluşturur)
# false: Önceden üretilmiş statik görsellerden seçer (varsayılan, ücretsiz)
DYNAMIC_AI=false
